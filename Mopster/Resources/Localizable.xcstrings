    "Mopster finds clutter on your Mac and moves it to the Trash, so you stay in control.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mopster finds clutter on your Mac and moves it to the Trash, so you stay in control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mopster repère ce qui encombre votre Mac et le place dans la Corbeille, pour que vous gardiez le contrôle."
          }
        }
      }
    },
    "Full Disk Access lets Mopster see Mail downloads, Safari caches, the Trash size and some app containers.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Disk Access lets Mopster see Mail downloads, Safari caches, the Trash size and some app containers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès complet au disque permet à Mopster de voir les téléchargements de Mail, les caches de Safari, la taille de la Corbeille et certains conteneurs d’apps."
          }
        }
      }
    },
    "Mopster works without it and tells you what it skipped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mopster works without it and tells you what it skipped."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mopster fonctionne sans cet accès et vous indique ce qu’il a ignoré."
          }
        }
      }
    },
