    "junk.xcodeArchives.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old app archives and debug symbols for devices you have connected. Check them first: an archive can't be rebuilt exactly as it was."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anciennes archives d’apps et symboles de débogage des appareils que vous avez connectés. À vérifier d’abord : une archive ne peut pas être reconstruite à l’identique."
          }
        }
      }
    },
    "junk.developerCaches.title": {
