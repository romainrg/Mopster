    "maintenance.freeRAM.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free up RAM"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérer la RAM"
          }
        }
      }
    },
    "maintenance.freeRAM.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks macOS to release inactive memory. macOS already does this on its own; useful before a memory-hungry task."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande à macOS de libérer la mémoire inactive. macOS le fait déjà seul ; utile avant une tâche gourmande en mémoire."
          }
        }
      }
    },
    "maintenance.flushDNS.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flush DNS cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider le cache DNS"
          }
        }
      }
    },
    "maintenance.flushDNS.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgets the website addresses your Mac has remembered. Useful when a site moved or a network change left stale entries."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublie les adresses de sites que votre Mac a mémorisées. Utile quand un site a déménagé ou qu’un changement de réseau a laissé des entrées périmées."
          }
        }
      }
    },
    "maintenance.reindexSpotlight.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reindex Spotlight"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réindexer Spotlight"
          }
        }
      }
    },
    "maintenance.reindexSpotlight.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuilds the Spotlight search index of the startup disk. Search results are incomplete until it finishes, which can take a while."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruit l’index de recherche Spotlight du disque de démarrage. Les résultats sont incomplets tant qu’il n’a pas fini, ce qui peut prendre du temps."
          }
        }
      }
    },
    "maintenance.rebuildLaunchServices.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuild Launch Services database"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruire la base Launch Services"
          }
        }
      }
    },
    "maintenance.rebuildLaunchServices.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuilds the list that decides which app opens which file and fills the “Open With” menu. Useful when it shows apps that are gone or the wrong default."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruit la liste qui décide quelle app ouvre quel fichier et alimente le menu « Ouvrir avec ». Utile quand il affiche des apps disparues ou un mauvais choix par défaut."
          }
        }
      }
    },
    "maintenance.clearFontCaches.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear font caches"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider les caches de polices"
          }
        }
      }
    },
    "maintenance.clearFontCaches.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes your user font caches so macOS rebuilds them. Useful when fonts look wrong or are missing. Restarting your Mac afterwards is advised."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime vos caches de polices pour que macOS les reconstruise. Utile quand des polices s’affichent mal ou manquent. Un redémarrage du Mac est conseillé ensuite."
          }
        }
      }
    },
    "maintenance.resetQuickLook.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Quick Look cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser le cache Aperçu rapide"
          }
        }
      }
    },
    "maintenance.resetQuickLook.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears the cached previews and reloads Quick Look. Useful when a preview is stale or blank."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les aperçus en cache et recharge l’Aperçu rapide. Utile quand un aperçu est périmé ou vide."
          }
        }
      }
    },
    "maintenance.verifyStartupDisk.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify startup disk"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier le disque de démarrage"
          }
        }
      }
    },
    "maintenance.verifyStartupDisk.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks the startup volume for file system errors without changing anything. It can take a few minutes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche des erreurs du système de fichiers sur le volume de démarrage, sans rien modifier. Cela peut prendre quelques minutes."
          }
        }
      }
    },
