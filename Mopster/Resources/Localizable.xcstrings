    "junk.browserCaches.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser caches"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches des navigateurs"
          }
        }
      }
    },
    "junk.browserCaches.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files browsers keep to load pages faster. They are rebuilt automatically when needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers que les navigateurs conservent pour charger les pages plus vite. Ils sont recréés automatiquement au besoin."
          }
        }
      }
    },
    "junk.xcodeCaches.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode build caches"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches de build Xcode"
          }
        }
      }
    },
    "junk.xcodeCaches.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intermediate files from building projects and running simulators. Xcode recreates them on the next build."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers intermédiaires issus de la compilation et des simulateurs. Xcode les recrée au prochain build."
          }
        }
      }
    },
    "junk.xcodeArchives.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode archives and device support"
