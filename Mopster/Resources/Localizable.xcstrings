    "junk.developerCaches.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Packages and build outputs kept by developer tools. They are downloaded or built again when needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquets et résultats de compilation conservés par les outils de développement. Ils sont retéléchargés ou recompilés au besoin."
